# ==========================================
# GreenRoots Frontend Environment Variables
# Configure these in your frontend host (Vercel, Netlify, Cloudflare Pages, etc.)
# ==========================================

# When backend is hosted separately, provide the backend base URL (e.g. https://greenroots-backend.onrender.com)
# Leave empty if frontend is served from the same server or proxy
REACT_APP_API_URL=
