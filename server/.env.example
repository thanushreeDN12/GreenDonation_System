# ==========================================
# GreenRoots Backend Environment Variables
# Configure these in your backend host (Render, Railway, Heroku, AWS, etc.)
# DO NOT commit your real .env file with secrets to version control
# ==========================================

# Port for Express server (e.g. 5000, or provided automatically by cloud host)
PORT=5000

# MongoDB connection string (e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/greenroots?retryWrites=true&w=majority)
MONGO_URI=

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration duration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=1d

# Optional Google Gemini API Key for tree verification
GEMINI_API_KEY=
