# Port for Express server (defaults to 3000 or platform provided PORT)
PORT=3000

# MongoDB connection string
MONGO_URI=

# JWT Secret for authentication
JWT_SECRET=

# JWT Expiration time (e.g. 1h, 1d)
JWT_EXPIRES_IN=1d

# Optional API URL for client if hosted separately (leave blank for relative paths)
REACT_APP_API_URL=

# Gemini API Key for AI tree verification
GEMINI_API_KEY=

